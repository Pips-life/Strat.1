@Composable
private fun StrategiesScreen(modifier: Modifier, api: BackendApiClient, session: BackendSession?) {
    var bot by remember { mutableStateOf<BotState?>(null) }
    var selected by remember { mutableStateOf("001") }
    var pendingSelection by remember { mutableStateOf<String?>(null) }
    var busy by remember { mutableStateOf(false) }
    var message by remember { mutableStateOf("Choose the strategy the bot should trade.") }
    val scope = rememberCoroutineScope()

    LaunchedEffect(session) {
        if (session != null) while (true) {
            api.botStatus(session).onSuccess {
                bot = it
                val serverStrategy = it.strategy
                if (pendingSelection == null && (serverStrategy == "001" || serverStrategy == "002")) {
                    selected = serverStrategy
                } else if (pendingSelection != null && serverStrategy == pendingSelection) {
                    selected = serverStrategy
                    pendingSelection = null
                    message = "Strategy ${serverStrategy} active in engine."
                }
            }
            delay(3000)
        }
    }

    fun choose(strategy: String) {
        if (session == null) {
            message = "Connect MT5 before selecting a live trading strategy."
            return
        }
        selected = strategy
        pendingSelection = strategy
        message = "Activating Strategy $strategy…"
        busy = true
        scope.launch {
            api.botCommand(session, "select:$strategy")
                .onSuccess { selection ->
                    bot = selection
                    if (selection.strategy == strategy) {
                        selected = strategy
                        message = "Strategy $strategy active in engine. Starting trading…"
                        api.botCommand(session, "start:$strategy")
                            .onSuccess { started ->
                                bot = started
                                if (started.strategy == strategy) {
                                    pendingSelection = null
                                    message = "Strategy $strategy active and trading."
                                } else {
                                    message = "Strategy $strategy selected; waiting for engine confirmation."
                                }
                            }
                            .onFailure {
                                message = it.message ?: "Strategy selected, but trading could not be started."
                            }
                    } else {
                        message = "Strategy $strategy requested; waiting for engine confirmation."
                    }
                }
                .onFailure {
                    pendingSelection = null
                    message = it.message ?: "Strategy selection failed."
                }
            busy = false
        }
    }

    LazyColumn(
        modifier.fillMaxSize().background(Ink).padding(horizontal = 16.dp),
        verticalArrangement = Arrangement.spacedBy(14.dp),
        contentPadding = PaddingValues(top = 18.dp, bottom = 28.dp)
    ) {
        item { TopBar("Strategies", "CHOOSE THE ACTIVE TRADING STRATEGY", session != null) }
        item {
            Text(message, color = if (message.contains("active", true) || message.contains("trading", true)) Green else Muted, fontSize = 12.sp)
        }
        item {
            Card(
                onClick = { if (!busy) choose("001") },
                enabled = !busy,
                colors = CardDefaults.cardColors(containerColor = if (selected == "001") Panel2 else Panel),
                shape = RoundedCornerShape(22.dp),
                modifier = Modifier.fillMaxWidth().border(2.dp, if (selected == "001") Cyan else Line, RoundedCornerShape(22.dp))
            ) {
                Column(Modifier.padding(19.dp), verticalArrangement = Arrangement.spacedBy(11.dp)) {
                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                        Text("STRATEGY 001", color = Cyan, fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
                        StatusPill(if (selected == "001") "SELECTED" else "READY", if (selected == "001") Green else Cyan)
                    }
                    Text("STRATEGY 001", color = Primary, fontSize = 23.sp, fontWeight = FontWeight.Black)
                    Text("Primary QOF strategy. Tap this card to make it the active strategy for the bot.", color = Muted, fontSize = 12.sp)
                    Divider(color = Line)
                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                        Metric("ENGINE", "PROTECTED")
                        Metric("STATE", if (selected == "001") "SELECTED" else "READY")
                        Metric("ROLE", "PRIMARY")
                    }
                }
            }
        }
        item {
            Card(
                onClick = { if (!busy) choose("002") },
                enabled = !busy,
                colors = CardDefaults.cardColors(containerColor = if (selected == "002") Panel2 else Panel),
                shape = RoundedCornerShape(22.dp),
                modifier = Modifier.fillMaxWidth().border(2.dp, if (selected == "002") Cyan else Line, RoundedCornerShape(22.dp))
            ) {
                Column(Modifier.padding(19.dp), verticalArrangement = Arrangement.spacedBy(11.dp)) {
                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween, verticalAlignment = Alignment.CenterVertically) {
                        Text("STRATEGY 002", color = Cyan, fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
                        StatusPill(if (selected == "002") "SELECTED" else "READY", if (selected == "002") Green else Cyan)
                    }
                    Text("Velocity Expansion", color = Primary, fontSize = 23.sp, fontWeight = FontWeight.Black)
                    Text("Detects expanding price velocity, enters immediately in the detected direction, then maintains a 100-pip trailing opposite stop and reverses continuously when triggered.", color = Muted, fontSize = 12.sp)
                    Divider(color = Line)
                    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                        Metric("ENGINE", "PROTECTED")
                        Metric("STATE", if (selected == "002") "SELECTED" else "READY")
                        Metric("ROLE", "SECONDARY")
                    }
                }
            }
        }
        item {
            Card(colors = CardDefaults.cardColors(containerColor = Panel), shape = RoundedCornerShape(22.dp), modifier = Modifier.fillMaxWidth().border(1.dp, Line, RoundedCornerShape(22.dp))) {
                Column(Modifier.padding(19.dp), verticalArrangement = Arrangement.spacedBy(11.dp)) {
                    Text("STRATEGY 003", color = Purple, fontWeight = FontWeight.Bold, letterSpacing = 1.sp)
                    StatusPill("LOCKED", Purple)
                    Text("Reserved", color = Primary, fontSize = 23.sp, fontWeight = FontWeight.Black)
                    Text("Future strategy slot.", color = Muted, fontSize = 12.sp)
                }
            }
        }
    }
}
